{
  "manifest_version": 3,
  "name": "ClickTrap – Dark Pattern Detector",
  "version": "1.0.0",
  "description": "Identify deceptive user-interface designs, fake urgency, hidden costs, and manipulative patterns on websites.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ClickTrap – Scan for Dark Patterns",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["rules.js", "detector.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "content.css",
        "rules.js",
        "detector.js",
        "dashboard/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
